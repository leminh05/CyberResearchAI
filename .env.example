# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL in Docker (docker compose up -d). Choose any password; it is only
# used on this machine. The container listens on 127.0.0.1 only.
POSTGRES_USER=cyber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyberresearch
POSTGRES_PORT=5432

# Connection string used by the application on the host. Keep it in sync with
# the values above. Use 127.0.0.1, not "localhost": on Windows localhost
# resolves to IPv6 first and the connection stalls. Leave empty to use the embedded development database
# (pgserver, stored in data/pgdata/) instead of Docker.
DATABASE_URL=postgresql://cyber:change-me@127.0.0.1:5432/cyberresearch

# Claude API key for the chatbot (https://console.anthropic.com/settings/keys).
# Billed per use. Never commit the real value.
ANTHROPIC_API_KEY=

# Contact email sent to OpenAlex (polite pool) and in the User-Agent header.
CONTACT_EMAIL=your-email@example.com

# Optional OpenAlex API key (https://openalex.org/settings/api).
# Without a key: shared daily budget per IP and only the first 10,000 results
# of a query can be paged. With a key: cursor paging with unlimited depth.
OPENALEX_API_KEY=

# Optional Semantic Scholar API key (https://www.semanticscholar.org/product/api).
# Without a key, requests share a public pool and are throttled more often.
SEMANTIC_SCHOLAR_API_KEY=

# Ollama (free local LLM). The app container reaches the host's Ollama here.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Website in Docker (docker compose --profile web up -d): answer generator and
# host port. API keys stay on the backend; nothing here reaches the browser.
WEB_PROVIDER=ollama
WEB_PORT=8000
# Database for the website only. Set to cyberresearch_large after building that
# corpus (see README); leave empty for the main database.
WEB_DB=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
