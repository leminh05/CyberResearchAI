# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Leave empty to use the embedded development
# database (pgserver) stored in data/pgdata/.
# Example: postgresql://cyber:change-me@localhost:5432/cyberresearch
DATABASE_URL=

# Contact email sent to OpenAlex (polite pool) and in the User-Agent header.
CONTACT_EMAIL=your-email@example.com

# Optional OpenAlex API key (higher limits). Leave empty if you do not have one.
OPENALEX_API_KEY=

# Optional Semantic Scholar API key (https://www.semanticscholar.org/product/api).
# Without a key, requests share a public pool and are throttled more often.
SEMANTIC_SCHOLAR_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
