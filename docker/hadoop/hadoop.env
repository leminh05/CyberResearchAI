# Configuration of the local HDFS cluster. The apache/hadoop image turns each
# FILE.XML_key=value line into a setting in that Hadoop file.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/data/name
HDFS-SITE.XML_dfs.datanode.data.dir=/data/datanode
HDFS-SITE.XML_dfs.replication=2
# Single-user cluster on a private Docker network, reachable only from this machine.
HDFS-SITE.XML_dfs.permissions.enabled=false
